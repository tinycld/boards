node_modules/
*.tsbuildinfo
.DS_Store
# Linked-sibling packages must never ship a lockfile — peer deps
# resolve through the app shell's install. Ignore all common lockfiles
# in case `pnpm install` (or any other PM) accidentally runs here.
package-lock.json
pnpm-lock.yaml
yarn.lock
bun.lock
# Per-member Go workspace (generated by the app shell; resolves tinycld.org/core
# for standalone go build/test in this dir). Never committed — the assembled
# build uses app/server/go.work instead.
/server/go.work
/server/go.work.sum
